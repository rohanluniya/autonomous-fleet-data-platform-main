{
  "type": "record",
  "name": "AutonomyEvent",
  "namespace": "io.fleetplatform.events.v1",
  "doc": "Synthetic autonomy disengagement event. Explicitly simulated; does not represent real-world vehicle safety data.",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "vehicle_id", "type": "string"},
    {"name": "trip_id", "type": ["null", "string"], "default": null},
    {"name": "event_type", "type": "string"},
    {"name": "event_time", "type": "string"},
    {"name": "ingest_time", "type": ["null", "string"], "default": null},
    {"name": "sequence_number", "type": "long"},
    {"name": "schema_version", "type": "string", "default": "1.0.0"},
    {"name": "source_id", "type": "string"},
    {"name": "correlation_id", "type": "string"},
    {"name": "trace_id", "type": "string"},
    {"name": "latitude", "type": "double"},
    {"name": "longitude", "type": "double"},
    {"name": "region", "type": "string"},
    {"name": "software_version", "type": "string"},
    {"name": "disengagement_reason", "type": "string"},
    {"name": "autonomy_mode_before", "type": "string"},
    {"name": "takeover_latency_ms", "type": "int"},
    {"name": "synthetic_flag", "type": "boolean", "default": true},
    {"name": "metadata", "type": {"type": "map", "values": "string"}, "default": {}}
  ]
}
