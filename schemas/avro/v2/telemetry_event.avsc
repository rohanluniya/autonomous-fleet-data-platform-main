{
  "type": "record",
  "name": "TelemetryEvent",
  "namespace": "io.fleetplatform.events.v1",
  "doc": "Backward- and forward-compatible v2 evolution adding optional ambient_temp_c and tire_pressure_psi fields with defaults.",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "vehicle_id", "type": "string"},
    {"name": "trip_id", "type": ["null", "string"], "default": null},
    {"name": "event_type", "type": "string"},
    {"name": "event_time", "type": "string"},
    {"name": "ingest_time", "type": ["null", "string"], "default": null},
    {"name": "sequence_number", "type": "long"},
    {"name": "schema_version", "type": "string", "default": "2.0.0"},
    {"name": "source_id", "type": "string"},
    {"name": "correlation_id", "type": "string"},
    {"name": "trace_id", "type": "string"},
    {
      "name": "location",
      "type": [
        "null",
        {
          "type": "record",
          "name": "GeoLocation",
          "fields": [
            {"name": "latitude", "type": "double"},
            {"name": "longitude", "type": "double"},
            {"name": "heading_deg", "type": "double"},
            {"name": "altitude_m", "type": "double", "default": 0.0}
          ]
        }
      ],
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "TelemetryPayload",
        "fields": [
          {"name": "vehicle_state", "type": "string"},
          {"name": "region", "type": "string"},
          {"name": "vehicle_model", "type": "string"},
          {"name": "software_version", "type": "string"},
          {"name": "speed_mps", "type": "double"},
          {"name": "acceleration_mps2", "type": "double"},
          {"name": "braking_force_pct", "type": "double"},
          {"name": "battery_soc_pct", "type": "double"},
          {"name": "battery_temp_c", "type": "double"},
          {"name": "motor_temp_c", "type": "double"},
          {"name": "odometer_km", "type": "double"},
          {"name": "fault_codes", "type": {"type": "array", "items": "string"}, "default": []},
          {"name": "sensor_health_score", "type": "double"},
          {"name": "lidar_status", "type": "string", "default": "OK"},
          {"name": "camera_status", "type": "string", "default": "OK"},
          {"name": "radar_status", "type": "string", "default": "OK"},
          {"name": "ambient_temp_c", "type": ["null", "double"], "default": null},
          {"name": "tire_pressure_psi", "type": ["null", "double"], "default": null}
        ]
      }
    },
    {
      "name": "metadata",
      "type": {"type": "map", "values": "string"},
      "default": {}
    }
  ]
}
