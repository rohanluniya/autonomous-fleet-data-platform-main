# Autonomous Fleet Telemetry & Driving Intelligence Platform
# Copy to .env for local execution. Never commit .env with real secrets.

# Execution Mode: "local_native" (zero-Docker local fallback) or "docker" (full containerized cluster)
FLEET_ENV=dev
FLEET_TRANSPORT_MODE=local_wal
FLEET_WAREHOUSE_DIR=.local_data/warehouse
FLEET_WAL_DIR=.local_data/wal
FLEET_CHECKPOINT_DIR=.local_data/checkpoints
FLEET_LINEAGE_DIR=.local_data/lineage
FLEET_SQLITE_CATALOG_URI=sqlite:///.local_data/iceberg_catalog.db

# Kafka (used in docker / integration mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081/apis/ccompat/v7

# Object Storage (RustFS S3-compatible, used in docker mode)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=change_me_dev_access_key
S3_SECRET_ACCESS_KEY=change_me_dev_secret_key
S3_BUCKET=fleet-lakehouse

# Iceberg REST Catalog (Lakekeeper, used in docker mode)
ICEBERG_REST_URI=http://localhost:8181/catalog
ICEBERG_WAREHOUSE=fleet

# Operational PostgreSQL / PostGIS (used in docker mode)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fleet_ops
POSTGRES_USER=fleet_admin
POSTGRES_PASSWORD=change_me_dev_pg_password

# Trino (used in docker mode)
TRINO_HOST=localhost
TRINO_PORT=8085
TRINO_USER=fleet_reader

# FastAPI Security (local development API keys - replace via secret manager in production)
FLEET_API_HOST=127.0.0.1
FLEET_API_PORT=8000
FLEET_API_ADMIN_TOKEN=dev-admin-token-change-me
FLEET_API_OPERATOR_TOKEN=dev-operator-token-change-me
FLEET_API_ANALYST_TOKEN=dev-analyst-token-change-me
FLEET_API_PUBLIC_COARSEN_H3_RES=6

# Observability & Lineage
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=autonomous-fleet-platform
LOG_LEVEL=INFO
